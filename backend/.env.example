# RupeeRadar backend configuration.
# Copy this file to `.env` and fill in values. `.env` is git-ignored.

# --- Provider ---
LLM_PROVIDER=groq                       # groq | ollama | none
GROQ_API_KEY=                           # required when LLM_PROVIDER=groq (get one free at console.groq.com)
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=llama3.3                    # used only when LLM_PROVIDER=ollama

# --- Groq free-tier rate limits for llama-3.3-70b-versatile ---
# These are the hard ceilings the budget guard enforces (RPM/TPM/RPD/TPD).
# TPM = 1,000 tokens/min is the binding constraint. Change only if your account differs.
GROQ_RPM_LIMIT=30                       # requests / minute
GROQ_TPM_LIMIT=1000                     # tokens / minute  (tightest limit)
GROQ_RPD_LIMIT=12000                    # requests / day
GROQ_TPD_LIMIT=100000                   # tokens / day

# --- Token budget / cost control (kept inside the limits above) ---
LLM_DAILY_TOKEN_BUDGET=100000           # soft daily cap; auto-clamped to GROQ_TPD_LIMIT
LLM_MAX_TOKENS_PER_CALL=500             # completion cap; auto-clamped below GROQ_TPM_LIMIT
LLM_CATEGORIZE_BATCH=15                 # small batches so one call stays well under TPM
LLM_ENABLE_CHAT=true                    # chat is the most token-hungry feature; toggle independently
LLM_ENABLE_NARRATIVE=true               # monthly narrative report via LLM
LLM_INSIGHT_MODE=polish                 # off | polish | generate

# --- Storage & limits ---
DB_PATH=./data/rupeeradar.db
SESSION_TTL_MINUTES=60                   # in-memory session store TTL (until SQLite lands)
MAX_UPLOAD_MB=10

# --- Server / CORS ---
FRONTEND_ORIGIN=http://localhost:5173
